[Unit]
Description=Delete expired noti uploads

[Service]
Type=oneshot
User=upload
Group=upload
ExecStart=/usr/local/bin/noti-upload-recv gc --root /var/lib/noti-upload
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/noti-upload
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
MemoryDenyWriteExecute=true
